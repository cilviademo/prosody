# Copy to .env (gitignored). Never commit real keys.

# Optional: skip FL Studio discovery and point straight at the executable.
# FLPF_FL_EXE=C:\Program Files\Image-Line\FL Studio 2024\FL64.exe

# Enables FL command-line rendering. Studio PC only.
# FLPF_RENDER=1

# Enables pywinauto GUI automation. Interactive desktop session only.
# FLPF_GUI=1

# LLM provider keys are not used before Phase 10 and nothing is sent without
# an explicit opt-in. See docs/privacy.md.
# ANTHROPIC_API_KEY=
