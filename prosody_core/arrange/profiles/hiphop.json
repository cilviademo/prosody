{
  "genre": "hiphop",
  "label": "Hip-Hop",
  "grammar": {
    "short": [
      "intro:4",
      "hook:8",
      "verse:16",
      "hook:8",
      "outro:4"
    ],
    "balanced": [
      "intro:4",
      "hook:8",
      "verse:16",
      "hook:8",
      "verse:16",
      "bridge:8",
      "hook:16",
      "outro:4"
    ],
    "full": [
      "intro:4",
      "hook:8",
      "verse:16",
      "hook:8",
      "verse:16",
      "bridge:8",
      "hook:16",
      "verse:8",
      "hook:16",
      "outro:8"
    ]
  },
  "energy": {
    "intro": 0.3,
    "verse": 0.55,
    "pre": 0.7,
    "hook": 0.9,
    "chorus": 0.9,
    "build": 0.75,
    "drop": 1.0,
    "bridge": 0.4,
    "breakdown": 0.3,
    "outro": 0.2
  },
  "role_weights": {
    "kick": 0.2,
    "snare": 0.15,
    "hats": 0.1,
    "perc": 0.05,
    "bass": 0.2,
    "chords": 0.15,
    "melody": 0.15,
    "counter": 0.1,
    "vocal": 0.1,
    "fx": 0.05,
    "unknown": 0.0
  },
  "role_priority": [
    "chords",
    "melody",
    "kick",
    "snare",
    "bass",
    "hats",
    "perc",
    "counter",
    "vocal",
    "fx"
  ],
  "entry_rules": [
    {
      "role": "bass",
      "not_before": "hook",
      "absent_from": [
        "intro"
      ]
    },
    {
      "role": "counter",
      "not_before": "verse",
      "absent_from": [
        "intro"
      ]
    }
  ],
  "dropout_before": [
    "hook"
  ],
  "rules": [
    "808 enters with the first hook",
    "drum dropout on the last bar before each hook"
  ]
}
