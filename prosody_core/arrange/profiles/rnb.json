{
  "genre": "rnb",
  "label": "R&B",
  "grammar": {
    "short": [
      "intro:8",
      "verse:16",
      "pre:4",
      "chorus:8",
      "outro:8"
    ],
    "balanced": [
      "intro:8",
      "verse:16",
      "pre:4",
      "chorus:8",
      "verse:16",
      "pre:4",
      "chorus:8",
      "bridge:8",
      "chorus:8",
      "outro:8"
    ],
    "full": [
      "intro:8",
      "verse:16",
      "pre:4",
      "chorus:8",
      "verse:16",
      "pre:4",
      "chorus:8",
      "bridge:8",
      "chorus:16",
      "outro:8"
    ]
  },
  "energy": {
    "intro": 0.25,
    "verse": 0.5,
    "pre": 0.68,
    "hook": 0.85,
    "chorus": 0.85,
    "build": 0.7,
    "drop": 0.9,
    "bridge": 0.4,
    "breakdown": 0.3,
    "outro": 0.2
  },
  "role_weights": {
    "kick": 0.2,
    "snare": 0.15,
    "hats": 0.1,
    "perc": 0.05,
    "bass": 0.2,
    "chords": 0.15,
    "melody": 0.15,
    "counter": 0.1,
    "vocal": 0.1,
    "fx": 0.05,
    "unknown": 0.0
  },
  "role_priority": [
    "chords",
    "melody",
    "vocal",
    "bass",
    "kick",
    "snare",
    "hats",
    "counter",
    "perc",
    "fx"
  ],
  "entry_rules": [
    {
      "role": "bass",
      "not_before": "verse",
      "absent_from": [
        "intro"
      ]
    },
    {
      "role": "perc",
      "not_before": "chorus",
      "absent_from": [
        "intro",
        "verse"
      ]
    }
  ],
  "dropout_before": [
    "chorus"
  ],
  "rules": [
    "longer intro, chords lead",
    "percussion thinned in verses",
    "drums out for the last bar before each chorus"
  ]
}
